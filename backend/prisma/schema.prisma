generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum TripStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id                   Int              @id @default(autoincrement())
  fullName             String
  email                String           @unique
  password             String
  phone                String?          @unique
  role                 Role             @default(STAFF)
  isActive             Boolean          @default(true)
  mustChangePassword   Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  gmailConnection      GmailConnection?
}

model GmailConnection {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  email        String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model City {
  id        Int      @id @default(autoincrement())
  name      String
  state     String
  code      String   @unique
  clients   Client[]
  hotels    Hotel[]
}

model Client {
  id        Int       @id @default(autoincrement())
  fullName  String
  phone     String    @unique
  email     String?   @unique
  address   String?
  isActive  Boolean   @default(true)
  cityId    Int
  city      City      @relation(fields: [cityId], references: [id])
  bookings  Booking[]
  tours     Tour[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tour {
  id                Int           @id @default(autoincrement())
  clientId          Int
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  destination       String
  packageName       String
  travelDate        DateTime
  bookingDate       DateTime      @default(now())
  numberOfTravelers Int           @default(1)
  paymentStatus     PaymentStatus @default(UNPAID)
  tripStatus        TripStatus    @default(UPCOMING)
  remarks           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

