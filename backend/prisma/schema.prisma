model City {
  id        Int      @id @default(autoincrement())
  name      String
  state     String
  code      String   @unique

  clients   Client[]
}

model Client {
  id         Int      @id @default(autoincrement())
  fullName   String
  phone      String   @unique
  email      String?  @unique
  address    String?

  isActive   Boolean  @default(true)

  cityId     Int
  city       City     @relation(fields: [cityId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}