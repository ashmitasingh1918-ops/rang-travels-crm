model Hotel {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  category       String
  rating         Float?
  contactPerson  String
  email          String?  @unique
  phone          String?
  cityId         Int
  city           City     @relation(fields: [cityId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Booking {
  id            Int       @id @default(autoincrement())
  fileNo        String    @unique
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  travelers     Int       @default(1)
  status        String    @default("planning") // "planning", "emails_sent", "quotation_received", "hotel_confirmed", "completed", "cancelled"
  hotelName     String?
  hotelAddress  String?
  hotelPhone    String?
  hotelEmail    String?
  roomType      String?
  numberOfRooms String?
  mealPlan      String?
  nationality   String?
  vouchers      Voucher[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Voucher {
  id            Int       @id @default(autoincrement())
  bookingId     Int
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fileNo        String
  reservationNo String?
  hotelName     String
  hotelAddress  String?
  hotelPhone    String?
  guestName     String
  checkInDate   DateTime
  checkOutDate  DateTime
  roomType      String
  numberOfRooms String    @default("1")
  mealPlan      String
  nationality   String
  status        String    @default("DRAFT") // "DRAFT", "GENERATED", "SENT"
  pdfPath       String?
  createdBy     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TourCounter {
  financialYear String @id
  nextValue     Int    @default(1)
}